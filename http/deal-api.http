### 12. Завершение регистрации - отказ (безработный, маленький стаж)
# В этом случае калькулятор должен вернуть ошибку 400 (отказ в кредите)
POST {{baseUrl}}/deal/calculate/{{statementId}}
Content-Type: application/json

{
  "gender": "MALE",
  "maritalStatus": "SINGLE",
  "dependentAmount": 0,
  "passportIssueDate": "2018-01-01",
  "passportIssueBranch": "Отделение УФМС России по г. Новосибирск",
  "employment": {
    "employmentStatus": "UNEMPLOYED",
    "employerINN": "0000000000",
    "salary": 0,
    "position": "UNEMPLOYED",
    "workExperienceTotal": 0,
    "workExperienceCurrent": 0
  },
  "accountNumber": "40817810000000000004"
}

