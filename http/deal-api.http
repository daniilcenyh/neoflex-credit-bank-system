### Переменные окружения
@baseUrl = http://localhost:8093
# Вручную укажите statementId после создания заявки
@statementId = 123e4567-e89b-12d3-a456-426614174000

### 1. Health Check
GET {{baseUrl}}/actuator/health
Accept: application/json

### 2. Prometheus Metrics
GET {{baseUrl}}/actuator/prometheus
Accept: text/plain

### 3. Создание заявки и расчёт предложений (успешный сценарий)
POST {{baseUrl}}/deal/statement
Content-Type: application/json

{
  "amount": 500000,
  "term": 12,
  "firstName": "Daniil",
  "lastName": "Chernykh",
  "middleName": "Nickolaevich",
  "email": "daniilcernyh2006@mail.com",
  "birthdate": "2006-02-05",
  "passportSeries": "2020",
  "passportNumber": "403291"
}


### Выбор заявки для меня (тестирование полного цикла работы АПИ)
POST {{baseUrl}}/deal/offer/select
Content-Type: application/json

{
  "statementId": "85164af7-d8f5-4d95-9a7d-ea0e16d7153b",
  "requestedAmount": 500000,
  "totalAmount": 600000,
  "term": 12,
  "monthlyPayment": 53029.00,
  "rate": 11.0,
  "isInsuranceEnabled": true,
  "isSalaryClient": true
}

### Завершение заявки для меня (тестирование полного цикла работы АПИ)
POST {{baseUrl}}/deal/calculate/85164af7-d8f5-4d95-9a7d-ea0e16d7153b
Content-Type: application/json

{
  "gender": "MALE",
  "maritalStatus": "SINGLE",
  "dependentAmount": 0,
  "passportIssueDate": "2020-03-15",
  "passportIssueBranch": "Отделение УФМС России по г. Москва",
  "employment": {
    "employmentStatus": "EMPLOYED",
    "employerINN": "7707083893",
    "salary": 150000,
    "position": "MIDDLE_MANAGER",
    "workExperienceTotal": 24,
    "workExperienceCurrent": 12
  },
  "accountNumber": "40817810000000000001"
}

